rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function coach() { return signedIn() && (profile().isAdmin == true || ('role' in profile() && profile().role == 'coach')); }
    function student() { return signedIn() && 'role' in profile() && profile().role == 'student'; }
    function admin() { return coach(); }
    function sameOrganisation(data) {
      return !('organisationId' in data) || !('organisationId' in profile()) || data.organisationId == profile().organisationId;
    }
    function owns(data) { return signedIn() && data.creatorId == request.auth.uid; }

    match /profiles/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || admin());
      allow create: if signedIn() && userId == request.auth.uid && request.resource.data.isAdmin != true && (!('role' in request.resource.data) || request.resource.data.role in ['staff', 'student']);
      allow update: if signedIn() && (admin() || (userId == request.auth.uid && request.resource.data.isAdmin == resource.data.isAdmin && request.resource.data.get('role', 'staff') == resource.data.get('role', 'staff')));
      allow delete: if admin();
    }

    match /workouts/{workoutId} {
      allow read: if signedIn() && sameOrganisation(resource.data);
      allow create: if (coach() || student()) && request.resource.data.creatorId == request.auth.uid;
      allow update: if (coach() || student()) && owns(resource.data) && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if (coach() || student()) && owns(resource.data);
    }

    match /sessions/{sessionId} {
      // Sessions are discoverable class listings for signed-in members. Writes
      // remain owner/admin-only; organisation scoping is applied by the client
      // until all legacy records have an organisationId that rules can query.
      allow read: if signedIn();
      allow create: if (coach() || student()) && request.resource.data.creatorId == request.auth.uid
        && (coach() || (request.resource.data.sessionType == 'student-led'
          && request.resource.data.workoutId is string
          && get(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)).data.creatorId == request.auth.uid));
      allow delete: if (coach() || student()) && owns(resource.data);
      allow update: if (coach() || student()) && owns(resource.data)
        && request.resource.data.creatorId == resource.data.creatorId
        && (coach() || (resource.data.sessionType == 'student-led'
          && request.resource.data.sessionType == 'student-led'
          && request.resource.data.get('creatorRole', 'student') == resource.data.get('creatorRole', 'student')));

      match /rsvps/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && (admin() || (userId == request.auth.uid && request.resource.data.userId == request.auth.uid));
        allow delete: if signedIn() && (userId == request.auth.uid || admin());
      }
      match /bookingSlots/{slotId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && !exists(/databases/$(database)/documents/sessions/$(sessionId)/bookingSlots/$(slotId))
          && request.resource.data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/sessions/$(sessionId)/rsvps/$(request.auth.uid)).data.slot == int(slotId);
        allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
        allow update: if false;
      }
      match /attendees/{userId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && (userId == request.auth.uid || admin());
      }
      match /liveState/{stateId} {
        allow read: if signedIn();
        allow write: if (coach() || student()) && owns(get(/databases/$(database)/documents/sessions/$(sessionId)).data);
      }
    }

    match /attendance/{recordId} {
      allow read: if signedIn() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (admin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if admin() && owns(resource.data);
    }

    match /scores/{scoreId} {
      allow read: if signedIn() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (admin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if signedIn() && (admin() || resource.data.userId == request.auth.uid);
    }

    match /exercises/{exerciseId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    // Collection-group queries need an explicit recursive match. Mutations are
    // still governed by the session-scoped RSVP rule above.
    match /{path=**}/rsvps/{userId} {
      allow read: if signedIn();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
